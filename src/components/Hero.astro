---
// Hero principal
---

<div
  class="hero"
  style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 16px 32px 16px;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);"
>
  <img
    class="perfil"
    src="./perfil.webp"
    alt="Foto de Javier Aragón"
    {...{ fetchPriority: "High" }}
    style="border-radius:50%;border:3px solid #e94560;box-shadow:0 4px 16px rgba(233,69,96,0.2);margin-bottom:16px;"
  />
  <h1 style="font-size:2.5rem;font-weight:800;color:#e94560;margin:0 0 8px 0;">
    Javier Aragón
  </h1>
  <h2 style="font-size:1.3rem;font-weight:500;color:#f7b267;margin:0 0 16px 0;">
    Desarrollador Web Jr | Infraestructura de redes.
  </h2>
  <p style="color:#b2becd;font-size:1.1rem;text-align:center;max-width:600px;">
    Apasionado por la tecnología, el diseño y la creación de experiencias
    digitales modernas y funcionales.
  </p>
</div>

<style>
  .perfil {
    width: 150px;
    height: 150px;
  }
  @media screen and (max-width: 750px) {
    .perfil {
      width: 300px;
      height: 300px;
    }
  }
</style>
