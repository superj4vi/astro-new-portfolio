---
// Layout principal para el sitio web
const { title = "Javier Aragón | Desarrollador Web" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="google-site-verification"
      content="Wtr_9qLXzem3pvzVhoDu_Uv3t-p3z4H0C9WFOfKtPdA"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="./assets/logo.png" />
    <link rel="apple-touch-icon" href="./logo.svg" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css"
    />

    <!-- <link rel="stylesheet" href="../style/global.css" /> -->
    <style>
      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
        background: #222831;
        color: #fff;
        min-height: 100vh;
      }
      main {
        min-height: 80vh;
      }
    </style>
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-SEJ3GNRKJQ"
      is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-SEJ3GNRKJQ");
    </script>
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <script defer src="/scripts/menu-hamburger.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SEJ3GNRKJQ"
    ></script>
  </body>
</html>
